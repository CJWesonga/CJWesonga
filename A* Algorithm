from heapq import heappop, heappush

def a_star(graph, start, goal, heuristic):
    open_set = []
    heappush(open_set, (0 + heuristic[start], 0, start))
    came_from = {}
    g_score = {node: float('inf') for node in graph}
    g_score[start] = 0

    while open_set:
        _, cost, current = heappop(open_set)

        if current == goal:
            path = []
            while current in came_from:
                path.append(current)
                current = came_from[current]
            path.append(start)
            return path[::-1]

        for neighbor, weight in graph[current].items():
            tentative_g = g_score[current] + weight
            if tentative_g < g_score[neighbor]:
                came_from[neighbor] = current
                g_score[neighbor] = tentative_g
                f_score = tentative_g + heuristic[neighbor]
                heappush(open_set, (f_score, tentative_g, neighbor))

    return None

# Example graph and heuristic
graph = {
    'A': {'B': 1, 'C': 3},
    'B': {'A': 1, 'D': 1},
    'C': {'A': 3, 'D': 1},
    'D': {'B': 1, 'C': 1, 'E': 5},
    'E': {}
}
heuristic = {'A': 4, 'B': 2, 'C': 2, 'D': 1, 'E': 0}

print("A*:", a_star(graph, 'A', 'E', heuristic))
